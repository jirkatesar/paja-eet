<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The parent stays the platform's Material theme: this app draws everything
      in Compose, so an AppCompat/MaterialComponents parent would only add a
      dependency for a look nothing uses. What it does need is the right window
      background, so launching does not flash white in dark mode.
    -->
    <style name="Theme.PajaEet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
